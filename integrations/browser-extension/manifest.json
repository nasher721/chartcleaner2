{
  "manifest_version": 3,
  "name": "Chart Cleaner",
  "version": "1.0.0",
  "description": "Right-click selected chart text to clean, abbreviate or expand it with the Chart Cleaner app running on this computer.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "Chart Cleaner settings"}
}
