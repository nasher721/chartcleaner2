{
    "_pack": {
        "name": "HIPAA Safe Harbor (strict)",
        "description": "Aggressive removal of the 18 HIPAA identifier categories: all dates, names on label lines, phones/faxes, emails, SSNs, MRN/account/health-plan numbers, license and device IDs, URLs, IPs, ZIPs, ages over 89. For sharing outside your organization.",
        "source": "Inspired by redactable (github.com/PraneelBhatia/redactable) jurisdiction policy packs; patterns hand-written for Chart Cleaner.",
        "version": "1.0"
    },
    "emr_line_metadata": [
        "^\\s*(?:Author|Author Type|Cosigner|Cosign Required|Editor|Filed|Signed By|Dictated by)\\s*:.*$\\n?",
        "^\\s*Version \\d+ of \\d+\\s*$\\n?",
        "\\bPager\\s*:\\s*v?\\d+.*$\\n?"
    ],
    "boilerplate": [
        "(?is)this (?:document|note) contains (?:protected health information|confidential).*?(?:\\n\\n|$)"
    ],
    "epic_phi_patterns": [
        ["(?im)^\\s*(?:Patient(?: Name)?|Name)\\s*:\\s*.+$", "[REDACTED_NAME_LINE]"],
        ["(?im)^\\s*(?:Next of Kin|Emergency Contact(?: Person)?|Primary Emergency Contact)\\s*:\\s*.+$", "[REDACTED_CONTACT_LINE]"],
        ["\\b(?:0?[1-9]|1[0-2])[\\/\\-](?:0?[1-9]|[12]\\d|3[01])[\\/\\-](?:19|20)?\\d{2}\\b", "[REDACTED_DATE]"],
        ["\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\.?\\s+\\d{1,2},?\\s+(?:19|20)\\d{2}\\b", "[REDACTED_DATE]"],
        ["(?<!\\d)(?:\\+?1[\\s.\\-]?)?(?:\\(\\d{3}\\)|\\d{3})[\\s.\\-]\\d{3}[\\s.\\-]\\d{4}(?!\\d)", "[REDACTED_PHONE]"],
        ["(?im)^\\s*Fax\\s*:\\s*.+$", "[REDACTED_FAX_LINE]"],
        ["[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}", "[REDACTED_EMAIL]"],
        ["\\b\\d{3}-\\d{2}-\\d{4}\\b", "[REDACTED_SSN]"],
        ["\\b(?:PID|MRN|MR#?|PT\\.?\\s*ID|Patient ID)\\s*[:#]?\\s*\\d+\\b", "[REDACTED_ID]"],
        ["\\b(?:Health Plan(?: Number|#)?|Account(?: Number|#)?|Accession|Case)\\s*(?:Number|#|No\\.?)?\\s*[:#]?\\s*[A-Z0-9][A-Z0-9\\-]{4,}\\b", "[REDACTED_ACCOUNT]"],
        ["\\b(?:License|Lic\\.?|Driver'?s\\s+Lic(?:ense)?\\.?)\\s*(?:Number|#|No\\.?)?\\s*[:#]?\\s*[A-Z0-9][A-Z0-9\\-]{4,}\\b", "[REDACTED_LICENSE]"],
        ["\\b(?:Serial(?: Number)?|Device ID|IMEI|VIN)\\s*(?:#|No\\.?|Number)?\\s*[:#]?\\s*[A-Z0-9][A-Z0-9\\-]{5,}\\b", "[REDACTED_DEVICE_ID]"],
        ["\\bhttps?://[^\\s]+", "[REDACTED_URL]"],
        ["\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b", "[REDACTED_IP]"],
        ["(?im)^\\s*(?:ZIP|Zip Code|Postal Code)\\s*[:=]\\s*\\d{5}(?:-\\d{4})?", "[REDACTED_ZIP]"],
        ["(?i)\\b\\s*age\\s*[:=]\\s*(?:9[0-9]|1[0-9]{2})\\b", "[REDACTED_AGE>89]"],
        ["(?:DOB|Date of Birth)\\s*[:.]?\\s*(?:\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4}|(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\\.?\\s+\\d{1,2},?\\s+\\d{4})\\b", "[REDACTED_DOB]"]
    ],
    "literal_replacements": [],
    "clinical_headers": [
        "Subjective", "Objective", "Assessment & Plan", "Assessment", "Plan",
        "Vitals", "Labs", "Imaging", "Diagnostic tests", "Medications",
        "Allergies", "Past Medical History", "Social History", "Family History",
        "Physical Exam", "Review of Systems", "Hospital Course", "Discharge"
    ],
    "nlp_redaction": {
        "enabled": true,
        "entities": {
            "PERSON": "[REDACTED_NAME]",
            "PHONE_NUMBER": "[REDACTED_PHONE]",
            "EMAIL_ADDRESS": "[REDACTED_EMAIL]",
            "LOCATION": "[REDACTED_LOCATION]",
            "URL": "[REDACTED_URL]"
        }
    },
    "wrap_output": true,
    "wrap_tag": "patient_chart"
}
