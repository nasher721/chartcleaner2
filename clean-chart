#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="${ROOT}/.venv/bin/python"

if [[ ! -x "$PY" ]]; then
  echo "No virtual environment found. Run once from this folder:" >&2
  echo "  ./install.sh" >&2
  exit 1
fi

exec "$PY" "${ROOT}/medical_cleaner.py" "$@"
